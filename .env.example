# Database
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# Admin Authentication
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_password
SESSION_SECRET=generate_a_random_32_character_string_here

# Payment Gateway (Razorpay)
RAZOR_PAY_KEY_ID=rzp_live_or_test_key_id
RAZOR_PAY_KEY_SECRET=rzp_live_or_test_key_secret
NEXT_PUBLIC_RAZOR_PAY_KEY_ID=rzp_live_or_test_key_id
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Cloudflare R2 Storage (S3-Compatible Object Storage with CDN)
# 1. R2_ACCOUNT_ID: Found in your Cloudflare dashboard URL or R2 overview page
R2_ACCOUNT_ID=your_cloudflare_account_id
# 2. R2_ACCESS_KEY_ID & R2_SECRET_ACCESS_KEY: Created under R2 -> "Manage R2 API Tokens"
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
# 3. R2_BUCKET_NAME: The name of your R2 bucket (e.g., attirenest-media)
R2_BUCKET_NAME=your_r2_bucket_name
# 4. R2_PUBLIC_URL: Custom Domain connected to bucket with Cloudflare CDN or pub-<id>.r2.dev URL
# Example with custom domain: https://media.yourdomain.com
# Example with r2.dev domain: https://pub-xxxxxxxx.r2.dev
R2_PUBLIC_URL=https://your-custom-cdn-domain-or-r2-dev-url
